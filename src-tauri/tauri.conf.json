{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoonTask",
  "version": "0.2.2",
  "identifier": "io.moontask.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MoonTask – Task Manager",
        "width": 1320,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis"],
    "publisher": "Luna-OS",
    "homepage": "https://github.com/Luna-OS/Moon-Task",
    "copyright": "© 2026 Luna",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "Every process, calmly under the moon.",
    "longDescription": "MoonTask is a calm, modern task manager: processes as a tree, a list or grouped by app, live CPU, GPU, memory, disk and network charts, open connections and services — with safe, confirmed actions.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "template": "installer/installer.nsi",
        "installerHooks": "installer/theme.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "languages": ["English", "German"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
